body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f2f2f2;
}

header {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 20px;
}

h2 {
    text-align: center;
    color: #333;
}

.container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 20px;
}

.produk {
    background-color: white;
    width: 100%;
    padding: 15px;
    box-sizing: border-box;
    text-align: center;
    border-radius: 10px;
}

.produk img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.produk h3 {
    color: #333;
}

.produk p {
    color: green;
    font-weight: bold;
}

footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px;
}

@media screen and (min-width: 600px) {
    .produk {
        width: calc(50% - 10px);
    }
}

@media screen and (min-width: 900px) {
    .produk {
        width: calc(33.33% - 14px);
    }
}
